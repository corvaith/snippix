PORT=3300
HOST=0.0.0.0
BASE_URL=https://api.example.com
# optional: require X-API-Key on render endpoints (empty = public)
API_KEY=
RATE_LIMIT_MAX=120
MEMORY_CACHE_MB=100
CACHE_DIR=/tmp/code-image-cache
# set 0 to disable disk cache (auto-disabled on Vercel via VERCEL=1)
CACHE_DISK=1
FILE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
MAX_CACHE_MB=500
